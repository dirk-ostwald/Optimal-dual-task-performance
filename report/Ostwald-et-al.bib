@article{kilner2010,
  title = {Topological Inference for {{EEG}} and {{MEG}}},
  author = {Kilner, James M. and Friston, Karl J.},
  year = 2010,
  month = sep,
  journal = {The Annals of Applied Statistics},
  volume = {4},
