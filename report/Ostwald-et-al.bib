  file = {C\:\\Users\\dirko\\Zotero\\storage\\JFT7QMK2\\Lenartowicz et al. - 2025 - The multidimensional relationship between alpha oscillations and cognition.pdf;C\:\\Users\\dirko\\Zotero\\storage\\5DF6Z3WF\\IMAG.a.html}
