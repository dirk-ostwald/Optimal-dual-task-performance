@article{liakoni2021,
  title = {Learning in {{Volatile Environments With}} the {{Bayes Factor Surprise}}},
  author = {Liakoni, Vasiliki and Modirshanechi, Alireza and Gerstner, Wulfram and Brea, Johanni},
