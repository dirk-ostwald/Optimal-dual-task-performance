  author = {Augustat, Nick},
  year = 2022,
  month = may,
  publisher = {Philipps-Universit\"at Marburg},
  doi = {10.17192/FDR/89},
  urldate = {2022-11-01},
  abstract = {Although expectancy effects induced by placebo treatment are reported to attenuate depressive symptoms in the long run, mechanisms underlying situational dynamics are not well understood. Improved reward learning has been discussed as a candidate mediator for effects of positive expectancies on more positive mood. Here, we fitted a series of Q-learning models to measure the effect of sham antidepressant treatment vs. openlabel placebo in a probabilistic reinforcement learning task. Treatment effects were observed mainly in those Q-learning models justified by the task structure. Additionally, interindividual variability remained the largest origin of unexplained variance in predictive match across models. These findings provide further support for the role of expectancies in reward learning. They also highlight the need for unraveling individual differences in cognitive mechanisms that account for differences in reward learning, and obtaining reliable estimates for them.},
  collaborator = {{Philipps-Universit{\"a}t Marburg} and {Philipps-Universit{\"a}t Marburg} and Chuang, Li-Ching and Dr, Christian, Panitz and Stolz, Christopher and Dr, Erik Malte Prof, M{\"u}ller and Dr, Dominik, Prof, Endres},
