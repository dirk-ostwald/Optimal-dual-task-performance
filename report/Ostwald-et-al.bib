  author = {Cuijpers, Pim and Miguel, Clara and Ciharova, Marketa and Harrer, Mathias and Basic, Djordje and Cristea, Ioana A. and De Ponti, Nino and Driessen, Ellen and Hamblen, Jessica and Larsen, Sadie E. and Matbouriahi, Minoo and Papola, Davide and Pauley, Darin and Plessen, Constantin Y. and Pfund, Rory A. and Setkowski, Kim and Schnurr, Paula P. and Van Ballegooijen, Wouter and Wang, Yingying and Riper, Heleen and Van Straten, Annemieke and Sijbrandij, Marit and Furukawa, Toshi A. and Karyotaki, Eirini},
