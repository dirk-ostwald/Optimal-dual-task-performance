@article{smith2021,
  title = {Simulating the Computational Mechanisms of Cognitive and Behavioral Psychotherapeutic Interventions: Insights from Active Inference},
  shorttitle = {Simulating the Computational Mechanisms of Cognitive and Behavioral Psychotherapeutic Interventions},
  author = {Smith, Ryan and Moutoussis, Michael and Bilek, Edda},
  year = 2021,
