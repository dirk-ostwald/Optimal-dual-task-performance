@article{haas2024,
  title = {Conformalized Prescriptive Machine Learning for Uncertainty-Aware Automated Decision Making: The Case of Goodwill Requests},
  shorttitle = {Conformalized Prescriptive Machine Learning for Uncertainty-Aware Automated Decision Making},
  author = {Haas, Stefan and H{\"u}llermeier, Eyke},
