@article{ostwald2006,
  title = {Effects on {{Hippocampus}} of {{Lifelong Absence}} of {{Glucocorticoids}} in the {{Pro-Opiomelanocortin Null Mutant Mouse Reveal Complex Relationship Between Glucocorticoids}} and {{Hippocampal Structure}} and {{Function}}},
