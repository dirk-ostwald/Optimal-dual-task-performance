@article{huk2018,
  title = {Beyond {{Trial-Based Paradigms}}: {{Continuous Behavior}}, {{Ongoing Neural Activity}}, and {{Natural Stimuli}}},
  shorttitle = {Beyond {{Trial-Based Paradigms}}},
  author = {Huk, Alexander and Bonnen, Kathryn and He, Biyu J.},
  year = 2018,
