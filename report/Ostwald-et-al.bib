@misc{fleischmann2026,
  title = {Video Games in Cognitive Event-Related {{EEG}} Research: {{A}} Scoping Review},
  shorttitle = {Video Games in Cognitive Event-Related {{EEG}} Research},
  author = {Fleischmann, Belinda and Mulready, Sean and Ostwald, Dirk},
  year = 2026,
  month = apr,
  doi = {10.31234/osf.io/5ktwb_v3},
  urldate = {2026-08-03},
  abstract = {Cognitive event-related EEG research has traditionally relied on controlled laboratory tasks that, while experimentally rigorous, offer limited ecological validity. Video games provide a promising step towards higher ecological validity: as engineered interactive environments, they are engaging by design and support more naturalistic task performance while permitting precise experimental control. Despite growing interest, their use in event-related EEG research has not been systematically evaluated. In this PRISMA-based scoping review, we characterize the types of video games used in event-related EEG paradigms and assess the extent to which canonical findings replicate during gameplay. Systematic searches in PubMed and Web of Science identified 23 eligible studies spanning multiple genres, presentation formats, and player perspectives. We categorized findings into stimulus-, response-, and feedback-related events and mapped them onto canonical ERP and oscillatory components. Several canonical components were observed, including N2 and P3 responses to unexpected and go/no-go stimuli, response-related readiness potentials, alpha/beta desynchronization, and error-related negativities, as well as feedback-related components such as the P3, the feedback-related negativity, and the reward positivity. These results illustrate how video game mechanics can instantiate common laboratory task events used to study neural signatures of attention, cognitive control, movement preparation, reward processing, and performance monitoring. In addition, we identified key methodological challenges that highlight custom-built video games as a promising middle ground between experimental control and ecological validity. Collectively, our findings support the feasibility of video game paradigms for event-related EEG research and provide a resource for developing intuitive, engaging EEG paradigms that preserve strong experimental control.},
  copyright = {https://creativecommons.org/licenses/by/4.0/legalcode}
}

