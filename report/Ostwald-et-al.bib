@article{li2015,
  title = {A Voxelation-Corrected Non-Stationary {{3D}} Cluster-Size Test Based on Random Field Theory},
  author = {Li, Huanjie and Nickerson, Lisa D. and Zhao, Xuna and Nichols, Thomas E. and Gao, Jia-Hong},
