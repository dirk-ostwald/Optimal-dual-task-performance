  author = {Cuijpers, Pim and Harrer, Mathias and Miguel, Clara and Ciharova, Marketa and Papola, Davide and Basic, Djordje and Botella, Cristina and Cristea, Ioana and De Ponti, Nino and Donker, Tara and Driessen, Ellen and Franco, Pamela and {G{\'o}mez-G{\'o}mez}, Irene and Hamblen, Jessica and {Jim{\'e}nez-Orenga}, Noelia and Karyotaki, Eirini and Keshen, Aaron and Linardon, Jake and Motrico, Emma and Matbouriahi, Minoo and Panagiotopoulou, Olga M. and Pfund, Rory A. and Plessen, Constantin Yves and Riper, Heleen and Schnurr, Paula P. and Sijbrandij, Marit and Toffolo, Marieke B. J. and Tong, Lingyao and Van Ballegooijen, Wouter and Van Der Ven, Els and Van Straten, Annemieke and Wang, Yingying and Furukawa, Toshi A.},
