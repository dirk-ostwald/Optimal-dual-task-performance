  author = {McGinley, Matthew J. and Vinck, Martin and Reimer, Jacob and {Batista-Brito}, Renata and Zagha, Edward and Cadwell, Cathryn R. and Tolias, Andreas S. and Cardin, Jessica A. and McCormick, David A.},
