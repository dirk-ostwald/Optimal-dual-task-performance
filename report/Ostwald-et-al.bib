@article{desiqueirarotenberg2025,
  title = {Metacognitive {{Training}} for {{Subjects}} with {{Bipolar Disorder}}: {{A Randomized Controlled Trial}}},
  shorttitle = {Metacognitive {{Training}} for {{Subjects}} with {{Bipolar Disorder}}},
  author = {De Siqueira Rotenberg, Luisa and Curvello, Renata and Nardini, Clara and Da Silva Franco, Milene and Carozzino, Maria Eduarda and Biazus, Ta{\'i}s Boeira and Campanha, Thuani and Garrudo Guirado, Alia and O\&apos;Malley, Grace and Stamm, Thomas J. and Lafer, Beny},
  year = 2025,
