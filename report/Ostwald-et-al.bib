@article{paul2020,
  title = {Dissociable Effects of Reward Magnitude on Fronto-Medial Theta and {{FRN}} during Performance Monitoring},
  author = {Paul, Katharina and Vassena, Eliana and Severo, Mario Carlo and Pourtois, Gilles},
  year = 2020,
  journal = {Psychophysiology},
  volume = {57},
  number = {2},
  pages = {e13481},
  issn = {1469-8986},
  doi = {10.1111/psyp.13481},
  urldate = {2025-08-28},
  abstract = {Reward processing is influenced by reward magnitude, as previous EEG studies showed changes in amplitude of the feedback-related negativity (FRN) and reward positivity (RewP), or power of fronto-medial theta (FM\texttheta ). However, it remains unclear whether these changes are driven by increased reward sensitivity, altered reward predictions, enhanced cognitive control, or a combination of these effects. To address this question, we asked 36 participants to perform a simple gambling task where feedback valence (reward vs. no-reward), its magnitude (small vs. large reward), and expectancy (expected vs. unexpected) were manipulated in a factorial design, while 64-channel EEG was recorded concurrently. We performed standard ERP analyses (FRN and RewP) as well as time-frequency decompositions (FM\texttheta ) of feedback-locked EEG data. Subjective reports showed that large rewards were more liked and expected than small ones. At the EEG level, increasing magnitude led to a larger RewP irrespective of expectancy, whereas the FRN was not influenced by this manipulation. In comparison, FM\texttheta{} power was overall increased when reward magnitude was large, except if it was unexpected. These results show dissociable effects of reward magnitude on the RewP and FM\texttheta{} power. Further, they suggest, that although large reward magnitude boosts reward processing (RewP), it can nonetheless undermine the need for enhanced cognitive control (FM\texttheta ) in case reward is unexpected. We discuss these new results in terms of optimistic bias or positive mood resulting from an increased reward magnitude.},
  copyright = {\copyright{} 2019 Society for Psychophysiological Research},
  langid = {english},
  keywords = {done-for-now,lev-1},
  file = {C\:\\Users\\dirko\\Zotero\\storage\\5DBHLUAJ\\Paul et al. - 2020 - Dissociable effects of reward magnitude on fronto-medial theta and FRN during performance monitoring.pdf;C\:\\Users\\dirko\\Zotero\\storage\\L2T4PIDR\\downloadSupplement.pdf}
}

@article{paul2025,
  title = {Revisiting the Electrophysiological Correlates of Valence and Expectancy in Reward Processing -- {{A}} Multi-Lab Replication},
  author = {Paul, Katharina and Angus, Douglas J. and Bublatzky, Florian and W{\"u}llhorst, Raoul and Endrass, Tanja and Greenwood, Lisa-Marie and Hajcak, Greg and Jack, Bradley N. and Korinth, Sebastian P. and Kroczek, Leon O.H. and Lucero, Boris and Mundorf, Annakarina and Nolden, Sophie and Peterburs, Jutta and Pfabigan, Daniela M. and Schettino, Antonio and Severo, Mario Carlo and Lee Shing, Yee and Turan, G{\"o}zem and Van Der Molen, Melle J.W. and Wieser, Matthias J. and Willscheid, Niclas and Mushtaq, Faisal and Pavlov, Yuri G. and Pourtois, Gilles},
  year = 2025,
  month = mar,
  journal = {Cortex},
  volume = {184},
  pages = {150--171},
  issn = {00109452},
  doi = {10.1016/j.cortex.2024.12.017},
  urldate = {2025-05-29},
  abstract = {Two event-related brain potential (ERP) components, the frontocentral feedback-related negativity (FRN) and the posterior P300, are key in feedback processing. The FRN typically exhibits greater amplitude in response to negative and unexpected outcomes, whereas the P300 is generally more pronounced for positive outcomes. In an influential ERP study, Hajcak et al., (2005) manipulated outcome valence and expectancy in a guessing task. They found the FRN was larger for negative outcomes regardless of expectancy, and the P300 larger for unexpected outcomes regardless of valence. These findings challenged the dominant Reinforcement Learning Theory of the ERN. We aimed to replicate these results within the \#EEGManyLabs project (Pavlov et al., 2021) across thirteen labs. Our replication, including robustness tests, a PCA and Bayesian models, found that both FRN and P300 were significantly modulated by outcome valence and expectancy: FRN amplitudes (no-reward - reward) were largest for unexpected outcomes, and P300 amplitudes were largest for reward outcomes. These results were consistent across different methods and analyses. Although our findings only partially replicate the original study, they underscore the complexity of feedback processing and demonstrate how aspects of Reinforcement Learning Theory may apply to the P300 component, reinforcing the need for rigorous ERP research methodologies.},
  langid = {english},
  keywords = {EEG: feedback-related negativity (FN),EEG: P300,EEG: RewP,lev-2},
  file = {C\:\\Users\\dirko\\Zotero\\storage\\3NJ9AJXD\\Paul et al. - 2025 - Revisiting the electrophysiological correlates of .pdf;C\:\\Users\\dirko\\Zotero\\storage\\LS8GWZRH\\Paul et al. - 2025 - Revisiting the electrophysiological correlates of valence and expectancy in reward processing – A mu.pdf;C\:\\Users\\dirko\\Zotero\\storage\\JV5ZPVBY\\S0010945224003617.html}
}

