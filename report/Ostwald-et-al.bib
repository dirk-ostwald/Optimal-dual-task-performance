@article{faniel2010,
  title = {Reusing {{Scientific Data}}: {{How Earthquake Engineering Researchers Assess}} the {{Reusability}} of {{Colleagues}}' {{Data}}},
  shorttitle = {Reusing {{Scientific Data}}},
