@article{mcfarquhar,
  title = {Modelling Group-Level Repeated Measures of Neuroimaging Data Using the Univariate General Linear Model},
  author = {McFarquhar, Martyn},
  pages = {12},
  abstract = {Group-level repeated measurements are common in neuroimaging, yet their analysis remains complex. Although a variety of specialised tools now exist, it is surprising that to-date there has been no clear discussion of how repeatedmeasurements can be appropriately modelled using the standard general linear model approach, implemented in software such as SPM and FSL. To understand how this can be achieved, two important concepts must be discussed. The first is the use of expected mean squares in defining suitable F-ratios for testing hypotheses. The second is the use of estimable functions in defining suitable contrast weights in overparameterised designs. In this paper, both of these concepts will be discussed in detail, paying particular attention to how they apply in complex repeated-measurement analyses. A set of simple steps will then be given alongside an example of specifying a 3-way repeated-measures ANOVA in SPM. Equivalency of the results compared to other standard statistical software will also be demonstrated. The hope is that this paper will provide some clarity on this confusing topic, giving researchers the confidence to correctly specify these forms of models in standard software packages.},
  langid = {english},
  file = {C:\Users\dirko\Zotero\storage\8W58NBK6\McFarquhar - Modelling group-level repeated measures of neuroim.pdf}
}

@article{mcfarquhar2016,
