  shorttitle = {The Future of Psychological Treatments},
  author = {Rief, Winfried and Asmundson, Gordon J.G. and Bryant, Richard A. and Clark, David M. and Ehlers, Anke and Holmes, Emily A. and McNally, Richard J. and Neufeld, Carmem B. and Wilhelm, Sabine and Jaroszewski, Adam C. and Berg, Max and Haberkamp, Anke and Hofmann, Stefan G.},
  year = 2024,
