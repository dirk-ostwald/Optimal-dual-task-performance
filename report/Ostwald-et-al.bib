  shorttitle = {The {{Impact}} of {{Visualization Dashboards}} on {{Quality}} of {{Care}} and {{Clinician Satisfaction}}},
  author = {Khairat, Saif Sherif and Dukkipati, Aniesha and Lauria, Heather Alico and Bice, Thomas and Travers, Debbie and Carson, Shannon S.},
